// Tests and build config (Node + Vitest globals). The source is also checked without them via tsconfig.src.json.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "vite.config.ts"
  ]
}
